.{
    // This is the default name used by packages depending on this one. For
    // example, when a user runs `zig fetch --save <url>`, this field is used
    // as the key in the `dependencies` table. Although the user can choose a
    // different name, most users will stick with this provided value.
    //
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .voxel_engine,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.0",
    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*. This allows
    // unambiguous detection of one package being an updated version of
    // another.
    //
    // When forking a Zig project, this id should be regenerated (delete the
    // field and run `zig build`) if the upstream project is still maintained.
    // Otherwise, the fork is *hostile*, attempting to take control over the
    // original project's identity. Thus it is recommended to leave the comment
    // on the following line intact, so that it shows up in code reviews that
    // modify the field.
    .fingerprint = 0x8b57168683336916, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.16.0",
    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        .nuklear = .{
            .url = "https://github.com/Immediate-Mode-UI/Nuklear/archive/0dbc52f86404f9e1f26ce0df3015ed23ff54a726.tar.gz",
            .hash = "N-V-__8AAGJoZQBw_GjGWjfW7aH6q-_hylCLzEuIfcvw-jW3",
        },
        .clap = .{
            .url = "https://github.com/Hejsil/zig-clap/archive/refs/tags/0.12.0.tar.gz",
            .hash = "clap-0.12.0-oBajB7foAQDqlSwaSG5g0yq7xGbQARUsBk5T64gAOqP5",
        },
        .sdl2 = .{
            .url = "https://github.com/libsdl-org/SDL/archive/refs/tags/release-2.32.4.tar.gz",
            .hash = "N-V-__8AAFIFtQR26acqQBhywLZyz6Rmc8onhPIxaL3BI0yQ",
        },
        .xorgproto = .{
            .url = "https://www.x.org/releases/individual/proto/xorgproto-2024.1.tar.xz",
            .hash = "N-V-__8AAJBbcQCJP91b8-T7BYBEwQNarvUXkrSsLo7z-9rl",
        },
        // Header-only deps: SDL's X11 backend dlopens the client libraries
        // at runtime (see plans/PORTABILITY.md), so only their headers are
        // needed at compile time. Nothing from these is compiled or linked.
        .libX11 = .{
            .url = "https://www.x.org/releases/individual/lib/libX11-1.8.10.tar.xz",
            .hash = "N-V-__8AABg99wDl5GY_5k3vs8UZ8fmMuqqF-CPhKCZ5vWUR",
        },
        .libXext = .{
            .url = "https://www.x.org/releases/individual/lib/libXext-1.3.6.tar.xz",
            .hash = "N-V-__8AAO45IwCuuMK54xADfiBcxyQPt4yfQQWOxN5rsTvH",
        },
        .libXcursor = .{
            .url = "https://www.x.org/releases/individual/lib/libXcursor-1.2.2.tar.xz",
            .hash = "N-V-__8AAGN9HADk-kv8KWtvP8aMiLMvLjDcF16S8GgRp96i",
        },
        .libXfixes = .{
            .url = "https://www.x.org/releases/individual/lib/libXfixes-6.0.1.tar.xz",
            .hash = "N-V-__8AAHiaGgAXe8dlADjfqy33PmMs4IDTv7-iW6mc91lv",
        },
        .libXi = .{
            .url = "https://www.x.org/releases/individual/lib/libXi-1.8.2.tar.xz",
            .hash = "N-V-__8AAJ9HLgA_JPs_oW57wbItPYPqqsZycB4n6kvoqEY1",
        },
        .libXrandr = .{
            .url = "https://www.x.org/releases/individual/lib/libXrandr-1.5.4.tar.xz",
            .hash = "N-V-__8AAIA7HADeakb-9QCcHyXssuAmjOZKN7vZQK52JhOU",
        },
        .libXrender = .{
            .url = "https://www.x.org/releases/individual/lib/libXrender-0.9.12.tar.xz",
            .hash = "N-V-__8AAHw9HgBticM-SMgcwIqbYguUzkdRnq6now53nmDf",
        },
        .libXScrnSaver = .{
            .url = "https://www.x.org/releases/individual/lib/libXScrnSaver-1.2.4.tar.xz",
